{
  "expo": {
    "name": "ResQDrive Mobile",
    "slug": "resqdrive-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#B71C1C"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Allow ResQDrive to use your location to find nearby hospitals and share your location during emergencies.",
        "NSMicrophoneUsageDescription": "ResQDrive needs microphone access to detect crash sounds for automatic emergency response."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#B71C1C"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "RECORD_AUDIO",
        "android.permission.CALL_PHONE",
        "android.permission.SEND_SMS",
        "android.permission.RECORD_AUDIO"
      ],
      "googleServicesFile": "./google-services.json",
      "package": "com.resqdrive.app"
    },
    "plugins": [
      "./plugins/withManifestFix",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "@react-native-voice/voice",
        {
          "microphonePermission": "Allow ResQDrive to recognize hands-free voice commands."
        }
      ],
      "./plugins/withExcludeOldSupportLib",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow ResQDrive to use your location to find nearby hospitals."
        }
      ],
      "expo-font",
      "expo-asset",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": ["peripheral", "central"],
          "bluetoothAlwaysPermission": "ResQDrive needs Bluetooth access to receive accident sensor data from the ESP32 in real time."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "24eb6ea0-8f61-4e5b-9756-9444639a92ba"
      }
    },
    "owner": "kamrankami313"
  }
}
